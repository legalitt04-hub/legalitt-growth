{
  "expo": {
    "name": "Legalitt",
    "slug": "legalitt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080A"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legalitt.app",
      "buildNumber": "1",
      "jsEngine": "hermes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Legalitt uses your location to find advocates near you.",
        "NSLocationAlwaysUsageDescription": "Legalitt uses your location to find advocates near you.",
        "NSCameraUsageDescription": "Legalitt uses your camera for video consultations and document scanning.",
        "NSMicrophoneUsageDescription": "Legalitt uses your microphone for voice and video consultations.",
        "NSPhotoLibraryUsageDescription": "Upload profile photo or documents."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080A"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "package": "com.legalitt.app",
      "versionCode": 3,
      "jsEngine": "hermes",
      "softwareKeyboardLayoutMode": "pan",
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-image-picker",
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0d9488"
        }
      ]
    ],
    "extra": {
      "API_URL": "https://legalitt-growth.onrender.com/api/v1",
      "SOCKET_URL": "https://legalitt-growth.onrender.com",
      "GOOGLE_WEB_CLIENT_ID": "400989529051-9r050me1vuquck9bqk30b6pd1i97k817.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID": "400989529051-5jmb7omhkks18b28oqf20b6nk19ggn3u.apps.googleusercontent.com",
      "RAZORPAY_KEY_ID": "rzp_test_SeC9MGzYmAerqz",
      "eas": {
        "projectId": "53a94562-25bc-4f1c-af15-ec4c792696dc"
      }
    }
  }
}
